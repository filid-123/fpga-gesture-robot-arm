* -text
# Preserve the exact sealed p4.1 bytes, including CRLF and model initialization data.
# New publication documents/scripts are written as UTF-8 with LF by their authoring tools.
project/** -whitespace
report/validation/** whitespace=cr-at-eol
report/acceptance/** whitespace=cr-at-eol

/AGENTS.md export-ignore
/AI_INSTRUCTIONS.md export-ignore
/CURRENT_PROJECT_CONTEXT.md export-ignore
/.agents export-ignore
